// This is your Prisma schema file for HRIS application,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Compatible with Supabase PostgreSQL via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Enums based on requirements and dummy data
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  SITE_ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  NOT_CHECKED_IN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}


// Site model (from locations in constants.ts)
model Site {
  id          String                    @id @default(cuid())
  name        String
  code        String                    @unique
  totalStaff  Int? // Optional, from stats
  companyId   String?
  company     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users       User[]
  attendances Attendance[]
  assignments EmployeeShiftAssignment[]
  patternAssignments EmployeePatternAssignment[] @relation("EmployeePatternAssignments")
  attendanceLocations AttendanceLocation[] @relation("SiteAttendanceLocations")
  patrolLocations PatrolLocation[]
  patrols     Patrol[]
  bulkImportRecords BulkImportRecord[] @relation("SiteBulkImports")
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@map("sites")
}

// Company model (clients)
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  sites     Site[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// Shift model (from shifts in constants.ts)
model Shift {
  id                 String                    @id @default(cuid())
  name               String
  startTime          String // HH:MM
  endTime            String // HH:MM
  gracePeriodMinutes Int
  assignments        EmployeeShiftAssignment[]
  Attendance         Attendance[]
  patrols            Patrol[]
  schedulePatterns   SchedulePattern[]

  @@map("shifts")
}

// User model (employees/admins/clients, with role, site, supervisor)
model User {
  id                    String                    @id @default(cuid())
  employeeCode          String?                   @unique
  name                  String
  email                 String                    @unique
  personalEmail         String?
  initials              String?
  department            String?
  position              String?
  role                  Role                      @default(STAFF)
  companyId             String?
  company               Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  siteId                String
  site                  Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisorId          String?
  supervisor            User?                     @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees           User[]                    @relation("Supervisor")
  attendances           Attendance[]
  leaves                Leave[]                   @relation("LeaveRequester")
  leavesApproved        Leave[]                   @relation("LeaveApprover")
  assignments           EmployeeShiftAssignment[]
  patternAssignments    EmployeePatternAssignment[] @relation("PatternAssignments")
  bulkImports           BulkImportLog[] @relation("BulkImports")
  patrols               Patrol[]
  deviceBindings        DeviceBinding[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  status                EmployeeStatus            @default(ACTIVE)
  joinDate              DateTime?                 @db.Date
  phoneNumber           String?
  ktpNumber             String?                   @unique
  address               String?
  birthCity             String?
  birthDate             DateTime?                 @db.Date
  bpjsNumber            String?
  gender                String?
  religion              String?
  maritalStatus         String?
  employmentStatus      String?
  bloodType             String?
  npwpNumber            String?
  ktaNumber             String?
  certifications        String[]
  ktaExpiry             DateTime?                 @db.Date
  allowMobileAttendance Boolean                   @default(false)
  allowWebAppAccess     Boolean                   @default(false)
  bankName              String?
  accountHolder         String?
  accountNumber         String?

  @@index([siteId])
  @@index([companyId])
  @@index([supervisorId])
  @@index([email])
  @@map("users")
}


// Junction for Employee Shift Assignment (schedules with workingDays array)
model EmployeeShiftAssignment {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       Shift  @relation(fields: [shiftId], references: [id])
  siteId      String
  site        Site   @relation(fields: [siteId], references: [id])
  workingDays Json // [0,1,2,3,4,5,6] as array of ints (Sun=0)

  @@unique([userId, shiftId, siteId])
  @@map("employee_shift_assignments")
}

// Attendance model (extended with GPS/selfie)
model Attendance {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime // Full datetime for date only in queries
  locationId     String
  location       Site             @relation(fields: [locationId], references: [id])
  shiftId        String?
  shift          Shift?           @relation(fields: [shiftId], references: [id])
  scheduledStart String? // HH:MM
  scheduledEnd   String? // HH:MM
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         AttendanceStatus @default(NOT_CHECKED_IN)
  lateMinutes    Int              @default(0)
  gpsLat         Float?
  gpsLng         Float?
  selfieCheckIn  String? // URL
  selfieCheckOut String? // URL
  notes          String?

  @@unique([userId, date])
  @@index([userId])
  @@index([locationId])
  @@index([date])
  @@map("attendances")
}

// Leave model (requests with approval)
model Leave {
  id          String      @id @default(cuid())
  requesterId String
  requester   User        @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approverId  String?
  approver    User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(PENDING)
  notes       String?

  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@map("leaves")
}

// Global system settings for branding
model SystemSettings {
  id             String  @id @default(cuid())
  logoUrl        String?
  appName        String  @default("SecureGuard")
  appDescription String  @default("HR Administration")

  @@map("system_settings")
}

model MasterData {
  id        String   @id @default(cuid())
  category  String   
  value     String   
  isActive  Boolean  @default(true) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@map("master_data")
}

// Attendance Location model (specific GPS locations at a site for attendance check-ins)
model AttendanceLocation {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation("SiteAttendanceLocations", fields: [siteId], references: [id], onDelete: Cascade)
  name      String   // Name of attendance location (e.g., "Main Entrance", "Security Booth")
  radius    Int      // Geofence radius in meters
  latitude  Float    // GPS coordinates for validation
  longitude Float
  timezone  String   @default("WIB") // Indonesia timezone: WIB, WITA, or WIT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("attendance_locations")
}

// Patrol Location model (specific locations at a site for patrol check-ins)
model PatrolLocation {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String   // Name of patrol location (e.g., "Gate A", "Building 1 Entrance")
  radius    Int      // Geofence radius in meters
  latitude  Float    // GPS coordinates for validation
  longitude Float
  timezone  String   @default("WIB") // Indonesia timezone: WIB, WITA, or WIT
  isActive  Boolean  @default(true)
  patrols   Patrol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("patrol_locations")
}

// Patrol model (patrol check-ins by user at specific times)
model Patrol {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  patrolLocationId  String
  patrolLocation    PatrolLocation      @relation(fields: [patrolLocationId], references: [id], onDelete: Cascade)
  shiftId           String?
  shift             Shift?              @relation(fields: [shiftId], references: [id])
  date              DateTime            // Date of patrol
  status            PatrolStatus        @default(NOT_STARTED)
  checkInTime       DateTime?           // Actual check-in time
  gpsLat            Float?              // Actual GPS latitude for validation
  gpsLng            Float?              // Actual GPS longitude
  gpsAccuracy       Float?              // GPS accuracy in meters
  barcodeScanned    Boolean             @default(false)
  gpsValidated      Boolean             @default(false)
  description       String?             // Description of patrol findings
  evidence          PatrolEvidence[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, patrolLocationId, date])
  @@index([userId])
  @@index([siteId])
  @@index([patrolLocationId])
  @@index([date])
  @@map("patrols")
}

// Patrol Evidence model (photos/documents from patrol)
model PatrolEvidence {
  id       String   @id @default(cuid())
  patrolId String
  patrol   Patrol   @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  imageUrl String   // URL to uploaded image
  caption  String? // Description of what the photo shows
  createdAt DateTime @default(now())

  @@index([patrolId])
  @@map("patrol_evidence")
}

// Device Binding model - restricts accounts to single device/app login
model DeviceBinding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String   @unique // Unique device identifier from mobile app
  deviceName    String   // e.g., "Samsung Galaxy S23 (Android)", "iPhone 14 Pro (iOS)"
  deviceType    String   // "mobile" or "app"
  appVersion    String?  // App version when bound
  bindDate      DateTime @default(now())
  lastUsed      DateTime @updatedAt
  isActive      Boolean  @default(true)

  @@unique([userId, deviceType]) // One mobile device + one app per user
  @@index([userId])
  @@index([deviceId])
  @@map("device_bindings")
}

// Enums for schedule patterns
enum PatternType {
  FIXED
  ROTATING
  MODULO
}

enum ShiftTypePattern {
  MORNING
  NIGHT
  OFF
}

// Schedule Pattern model - for managing shift schedules
model SchedulePattern {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        PatternType
  
  // For fixed patterns
  workingDays Json? // [0,1,2,3,4,5,6] as array of ints
  shiftId     String?
  shift       Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  // For rotating patterns - stored as JSON
  rotatingPattern Json? // { sequence: [{ days: 2, shiftType: 'morning' }, ...], startDate: '2026-01-01' }
  
  // For modulo patterns - stored as JSON
  moduloPattern Json? // { sequence: ['morning', 'morning', 'night', 'night'], startDate: '2026-01-01' }
  
  isActive          Boolean  @default(true)
  assignedEmployees Int      @default(0)
  employeeAssignments EmployeePatternAssignment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("schedule_patterns")
}

// Update Shift model to include schedule patterns
// (Added relation in Shift model below)

// Employee Pattern Assignment - assigns a schedule pattern to an employee
model EmployeePatternAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PatternAssignments", fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   SchedulePattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation("EmployeePatternAssignments", fields: [siteId], references: [id], onDelete: Cascade)
  startDate DateTime @default(now())
  endDate   DateTime? // Contract end date - null means ongoing
  status    String   @default("ACTIVE") // ACTIVE, ENDED, PAUSED
  createdBy String? // ID of user who made the assignment
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  notes     String? // Optional notes about the assignment
  
  // Bulk import tracking
  bulkImportRecords BulkImportRecord[]
  
  @@unique([userId, siteId, startDate])
  @@map("employee_pattern_assignments")
}

// Bulk Import Log - tracks all bulk import operations
model BulkImportLog {
  id                String   @id @default(cuid())
  fileName          String   // Original file name (e.g., "employees_patterns_2024.xlsx")
  importedBy        String   // Admin user ID who performed import
  importedByUser    User     @relation("BulkImports", fields: [importedBy], references: [id], onDelete: SetNull)
  totalRows         Int      // Total rows processed from file
  successCount      Int      // Successfully imported rows
  errorCount        Int      // Failed rows
  validationDetails Json     // Detailed validation errors/warnings as JSON
  status            String   @default("SUCCESS") // SUCCESS, FAILED, PARTIAL
  createdAt         DateTime @default(now())
  
  // Individual import records
  importRecords     BulkImportRecord[]
  
  @@map("bulk_import_logs")
}

// Individual records from bulk import
model BulkImportRecord {
  id              String   @id @default(cuid())
  bulkImportLogId String
  bulkImportLog   BulkImportLog @relation(fields: [bulkImportLogId], references: [id], onDelete: Cascade)
  
  employeeId      String   // Original employee ID from file
  employeeName    String?  // Employee name from file (for verification)
  siteId          String   // Site where assigned
  site            Site     @relation("SiteBulkImports", fields: [siteId], references: [id], onDelete: Cascade)
  
  assignmentId    String?  // Reference to created/updated EmployeePatternAssignment
  assignment      EmployeePatternAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  
  startDate       DateTime // Assignment start date
  endDate         DateTime? // Assignment end date
  dailySchedule   Json     // Mon-Sun shift schedule from file
  
  status          String   @default("SUCCESS") // SUCCESS, ERROR
  errorMessage    String?  // If status is ERROR, what went wrong
  createdAt       DateTime @default(now())
  
  @@map("bulk_import_records")
}
