// This is your Prisma schema file for HRIS application,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Compatible with Supabase PostgreSQL via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Enums based on requirements and dummy data
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  SITE_ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  NOT_CHECKED_IN
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

enum LeaveType {
  Izin
  Sakit
  TukarShift
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CronStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

enum CronJobName {
  ATTENDANCE_GENERATION
  LEAVE_PROCESSING
}

enum AuthChannel {
  WEB
  MOBILE
}

enum AuthResult {
  SUCCESS
  FAILED_INVALID_CREDENTIALS
  FAILED_DEVICE_LIMIT
  FAILED_OTHER
  FAILED_GPS_DENIED
  FAILED_GPS_TIMEOUT
  FAILED_OUT_OF_RADIUS
  FAILED_FAKE_GPS
  FAILED_CAMERA_DENIED
}

enum NotificationType {
  SYSTEM
  APPROVAL
  ANNOUNCEMENT
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum AnnouncementRecipientType {
  ALL_EMPLOYEES
  SITE_WIDE
  PERSONAL
  MULTI_SITE
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

// Site model (from locations in constants.ts)
model Site {
  id          String                    @id @default(cuid())
  name        String
  code        String                    @unique
  totalStaff  Int? // Optional, from stats
  latitude    Decimal?                  @db.Decimal(10, 8) // Geographic latitude coordinate
  longitude   Decimal?                  @db.Decimal(11, 8) // Geographic longitude coordinate
  companyId   String?
  company     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users       User[]
  attendances Attendance[]
  attendanceLocations AttendanceLocation[] @relation("SiteAttendanceLocations")
  patrolLocations PatrolLocation[]
  patrols     Patrol[]
  bulkImportRecords BulkImportRecord[] @relation("SiteBulkImports")
  shiftSwaps  ShiftSwap[]
  announcements Announcement[] @relation("SiteAnnouncements")
  
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@map("sites")
}

// Company model (clients)
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  sites     Site[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// Shift model (from shifts in constants.ts)
model Shift {
  id                 String                    @id @default(cuid())
  name               String
  startTime          String // HH:MM
  endTime            String // HH:MM
  gracePeriodMinutes Int
  Attendance         Attendance[]
  patrols            Patrol[]
  schedules          Schedule[]                @relation("ScheduleShifts")

  @@map("shifts")
}

// User model (employees/admins/clients, with role, site, supervisor)
model User {
  id                    String                    @id @default(cuid())
  employeeCode          String?                   @unique
  name                  String
  email                 String                    @unique
  personalEmail         String?
  initials              String?
  avatar                String?
  department            String?
  position              String?
  role                  Role                      @default(STAFF)
  companyId             String?
  company               Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  siteId                String
  site                  Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisorId          String?
  supervisor            User?                     @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees           User[]                    @relation("Supervisor")
  attendances           Attendance[]
  leaves                Leave[]                   @relation("LeaveRequester")
  bkoAssignments        BkoAssignment[]           @relation("BkoSubstitute")
  bulkImports           BulkImportLog[] @relation("BulkImports")
  patrols               Patrol[]
  deviceBindings        DeviceBinding[]
  authActivityLogs      AuthActivityLog[]
  notifications         Notification[]
  payrolls              Payroll[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  status                EmployeeStatus            @default(ACTIVE)
  joinDate              DateTime?                 @db.Date
  phoneNumber           String?
  ktpNumber             String?                   @unique
  address               String?
  birthCity             String?
  birthDate             DateTime?                 @db.Date
  bpjsNumber            String?
  gender                String?
  religion              String?
  maritalStatus         String?
  employmentStatus      String?
  bloodType             String?
  npwpNumber            String?
  ktaNumber             String?
  certifications        String[]
  ktaExpiry             DateTime?                 @db.Date
  allowMobileAttendance Boolean                   @default(false)
  allowWebAppAccess     Boolean                   @default(false)
  expoPushToken         String?                   @db.Text
  bankName              String?
  accountHolder         String?
  accountNumber         String?
  swapsFrom             ShiftSwap[]               @relation("SwapFrom")
  swapsTo               ShiftSwap[]               @relation("SwapTo")
  schedules             Schedule[]                @relation("EmployeeSchedules")
  announcementsCreated  Announcement[]            @relation("AnnouncementCreatedBy")
  announcementReadStatuses AnnouncementReadStatus[] @relation("AnnouncementReadStatus")

  @@index([siteId])
  @@index([companyId])
  @@index([supervisorId])
  @@index([email])
  @@map("users")
}


// Junction for Employee Shift Assignment (schedules with workingDays array)
// Attendance model (extended with GPS/selfie)
model Attendance {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date // Date only, no time component
  locationId     String?
  location       Site?            @relation(fields: [locationId], references: [id])
  shiftId        String?
  shift          Shift?           @relation(fields: [shiftId], references: [id])
  scheduledStart String? // HH:MM
  scheduledEnd   String? // HH:MM
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         AttendanceStatus @default(NOT_CHECKED_IN)
  lateMinutes    Int              @default(0)
  gpsLat         Float?           // GPS latitude for check-in
  gpsLng         Float?           // GPS longitude for check-in
  gpsLatPulang   Float?           // GPS latitude for check-out
  gpsLngPulang   Float?           // GPS longitude for check-out
  selfieCheckIn  String? // URL
  selfieCheckOut String? // URL
  notes          String?

  @@unique([userId, date])
  @@index([userId])
  @@index([locationId])
  @@index([date])
  @@map("attendances")
}

// Leave model (requests with approval)
model Leave {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  user              User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveType         String    // Izin (displayed as 'Cuti' in UI), Sakit, TukarShift
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  reason            String?
  attachmentUrl     String?
  status            String    @default("Pending") // Pending, Approved, Rejected
  workingDaysCount  Int       @default(0) // Actual working days affected based on pattern
  dayBreakdown      String?   // JSON string showing which days are counted vs skipped
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bkoAssignments    BkoAssignment[]

  @@index([userId])
  @@index([status])
  @@map("leaves")
}

// BKO Assignments (Backup/Coverage assignments during leave)
model BkoAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveId      String   @unique @db.Uuid
  leave        Leave    @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  substituteId String   // Text reference to User id (which is cuid)
  substitute   User     @relation("BkoSubstitute", fields: [substituteId], references: [id], onDelete: Cascade)
  status       String   @default("Aktif")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leaveId])
  @@index([substituteId])
  @@index([status])
  @@map("bko_assignments")
}

// Global system settings for branding
model SystemSettings {
  id             String  @id @default(cuid())
  logoUrl        String?
  appName        String  @default("SecureGuard")
  appDescription String  @default("HR Administration")
  appVersions   String? @map("AppVersions")
  
  @@map("system_settings")
}

model MasterData {
  id        String   @id @default(cuid())
  category  String   
  value     String   
  isActive  Boolean  @default(true) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@map("master_data")
}

// Attendance Location model (specific GPS locations at a site for attendance check-ins)
model AttendanceLocation {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation("SiteAttendanceLocations", fields: [siteId], references: [id], onDelete: Cascade)
  name      String   // Name of attendance location (e.g., "Main Entrance", "Security Booth")
  radius    Int      // Geofence radius in meters
  latitude  Float    // GPS coordinates for validation
  longitude Float
  timezone  String   @default("WIB") // Indonesia timezone: WIB, WITA, or WIT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("attendance_locations")
}

// Patrol Location model (specific locations at a site for patrol check-ins)
model PatrolLocation {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String   // Name of patrol location (e.g., "Gate A", "Building 1 Entrance")
  radius    Int      // Geofence radius in meters
  latitude  Float    // GPS coordinates for validation
  longitude Float
  timezone  String   @default("WIB") // Indonesia timezone: WIB, WITA, or WIT
  isActive  Boolean  @default(true)
  patrols   Patrol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("patrol_locations")
}

// Patrol model (patrol check-ins by user at specific times)
model Patrol {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  patrolLocationId  String
  patrolLocation    PatrolLocation      @relation(fields: [patrolLocationId], references: [id], onDelete: Cascade)
  shiftId           String?
  shift             Shift?              @relation(fields: [shiftId], references: [id])
  date              DateTime            @db.Date // Date of patrol, no time component
  status            PatrolStatus        @default(NOT_STARTED)
  checkInTime       DateTime?           // Actual check-in time
  gpsLat            Float?              // Actual GPS latitude for validation
  gpsLng            Float?              // Actual GPS longitude
  gpsAccuracy       Float?              // GPS accuracy in meters
  barcodeScanned    Boolean             @default(false)
  gpsValidated      Boolean             @default(false)
  description       String?             // Description of patrol findings
  evidence          PatrolEvidence[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, patrolLocationId, date])
  @@index([userId])
  @@index([siteId])
  @@index([patrolLocationId])
  @@index([date])
  @@map("patrols")
}

// Patrol Evidence model (photos/documents from patrol)
model PatrolEvidence {
  id       String   @id @default(cuid())
  patrolId String
  patrol   Patrol   @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  imageUrl String   // URL to uploaded image
  caption  String? // Description of what the photo shows
  createdAt DateTime @default(now())

  @@index([patrolId])
  @@map("patrol_evidence")
}

// Device Binding model - restricts accounts to single device/app login
model DeviceBinding {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String   // Device identifier from mobile app
  deviceName    String   // e.g., "Samsung Galaxy S23 (Android)", "iPhone 14 Pro (iOS)"
  deviceType    String   // "mobile" or "app"
  appVersion    String?  // App version when bound
  bindDate      DateTime @default(now())
  lastUsed      DateTime @default(now()) @updatedAt
  isActive      Boolean  @default(true)

  @@unique([userId, deviceType]) // One mobile device + one app per user
  @@unique([deviceId]) // Unique device identifier
  @@index([userId])
  @@index([deviceId])
  @@map("device_bindings")
}

// Auth Activity Log - records every login attempt (web + mobile) with outcome and reason
model AuthActivityLog {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String     // As entered, kept even if user lookup fails
  channel      AuthChannel
  result       AuthResult
  action       String?    // ATTENDANCE_IN or ATTENDANCE_OUT
  latitude     Float?
  longitude    Float?
  isMockLocation Boolean?
  distance     Float?     // Distance from attendance point in meters
  deviceId     String?    // Mobile only
  ipAddress    String?
  userAgent    String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([channel])
  @@index([result])
  @@map("auth_activity_logs")
}

// Enums for schedule patterns
// Schedule Pattern model - for managing shift schedules
// Update Shift model to include schedule patterns
// (Added relation in Shift model below)

// Employee Pattern Assignment - assigns a schedule pattern to an employee
// Bulk Import Log - tracks all bulk import operations
model BulkImportLog {
  id                String   @id @default(cuid())
  fileName          String   // Original file name (e.g., "employees_patterns_2024.xlsx")
  importedBy        String   // Admin user ID who performed import
  importedByUser    User     @relation("BulkImports", fields: [importedBy], references: [id], onDelete: SetNull)
  totalRows         Int      // Total rows processed from file
  successCount      Int      // Successfully imported rows
  errorCount        Int      // Failed rows
  validationDetails Json     // Detailed validation errors/warnings as JSON
  status            String   @default("SUCCESS") // SUCCESS, FAILED, PARTIAL
  createdAt         DateTime @default(now())
  
  // Individual import records
  importRecords     BulkImportRecord[]
  
  @@map("bulk_import_logs")
}

// Individual records from bulk import
model BulkImportRecord {
  id              String   @id @default(cuid())
  bulkImportLogId String
  bulkImportLog   BulkImportLog @relation(fields: [bulkImportLogId], references: [id], onDelete: Cascade)
  
  employeeId      String   // Original employee ID from file
  employeeName    String?  // Employee name from file (for verification)
  siteId          String   // Site where assigned
  site            Site     @relation("SiteBulkImports", fields: [siteId], references: [id], onDelete: Cascade)
  
  startDate       DateTime // Assignment start date
  endDate         DateTime? // Assignment end date
  dailySchedule   Json     // Mon-Sun shift schedule from file
  
  status          String   @default("SUCCESS") // SUCCESS, ERROR
  errorMessage    String?  // If status is ERROR, what went wrong
  createdAt       DateTime @default(now())
  
  @@map("bulk_import_records")
}

model ShiftSwap {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeFromId  String
  employeeFrom    User      @relation("SwapFrom", fields: [employeeFromId], references: [id], onDelete: Cascade)
  employeeToId    String
  employeeTo      User      @relation("SwapTo", fields: [employeeToId], references: [id], onDelete: Cascade)
  swapDate        DateTime  @db.Date
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reason          String?
  status          String    @default("Pending") // Pending, Approved, Rejected
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeFromId, employeeToId, swapDate]) // Prevent duplicate swaps on same date
  @@index([employeeFromId])
  @@index([employeeToId])
  @@index([status])
  @@index([swapDate])
  @@map("shift_swaps")
}

model Schedule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String
  employee        User      @relation("EmployeeSchedules", fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           Shift     @relation("ScheduleShifts", fields: [shiftId], references: [id], onDelete: Cascade)
  scheduleDate    DateTime  @db.Date
  shiftStart      String    // "09:00" format
  shiftEnd        String    // "17:00" format
  isException     Boolean   @default(false) // true if manually overridden
  notes           String?   // e.g., "Swapped with John", "Manual override"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, scheduleDate]) // One schedule per employee per day
  @@index([employeeId])
  @@index([scheduleDate])
  @@index([shiftId])
  @@map("schedules")
}

model CronLog {
  id              String    @id @default(cuid())
  jobName         String    @map("job_name") // "attendance_generation", "leave_processing", etc.
  status          String    @default("pending") @map("status") // "success", "pending", "error", "running"
  message         String?   @map("message")
  recordsCreated  Int       @default(0) @map("records_created")
  recordsSkipped  Int       @default(0) @map("records_skipped")
  error           String?   @map("error")
  duration        Int?      @map("duration") // Duration in milliseconds
  startTime       DateTime  @default(now()) @map("start_time")
  endTime         DateTime? @map("end_time")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@index([jobName, createdAt])
  @@index([status])
  @@map("cron_logs")
}

// Notification model - for user notifications with RLS and Realtime support
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  metadata  Json?            // Store extra details like request_id, entity_type, link_id, etc.
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// PAYROLL SYSTEM TABLES
// ============================================================================

// Enum for payroll period status
enum PayrollPeriodStatus {
  draft
  locked
  approved
  finalized
  paid
}

// Enum for overtime rule types
enum OvertimeRuleType {
  regular_backup
  national_holiday
  overtime_weekly
}

// Enum for deduction types
enum DeductionType {
  tax
  insurance
  health
  pension
  special
}

// Enum for deduction calculation type
enum DeductionCalculationType {
  percentage
  fixed_amount
}

// Enum for payroll calculation status
enum PayrollCalculationStatus {
  calculated
  approved_for_payment
  paid
  adjusted
}

// Enum for bonus type
enum BonusType {
  performance
  attendance
  special
  manual
}

// Enum for bonus status
enum BonusStatus {
  pending_approval
  approved
  rejected
  included_in_payroll
}

// Enum for overtime hours status
enum OvertimeHoursStatus {
  pending
  approved
  rejected
}

// TABLE 1: Salary Rules - Store salary configuration by position + site
model SalaryRule {
  id                String    @id @default(cuid())
  positionId        String    // References position/job title
  siteId            String    // References site ID
  baseSalary        Decimal   @db.Decimal(15, 2) // Monthly base salary
  positionAllowance Decimal   @db.Decimal(15, 2) // Position-specific allowance (e.g., risk allowance)
  minimumWage       Decimal   @db.Decimal(15, 2) // Government minimum wage baseline
  effectiveDate     DateTime  @db.Date
  endDate           DateTime? @db.Date // If rule expires
  status            String    @default("active") // active / inactive
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([positionId, siteId])
  @@index([siteId])
  @@index([status])
  @@map("salary_rules")
}

// TABLE 2: Overtime Rules - Store overtime multiplier configurations
model OvertimeRule {
  id              String             @id @default(cuid())
  type            OvertimeRuleType   // regular_backup, national_holiday, overtime_weekly
  description     String             // e.g., "National Holiday Duty"
  multiplier      Decimal            @db.Decimal(3, 2) // e.g., 1.5, 2.0, 2.5
  maxHoursPerMonth Int?              // e.g., 20 hours max per month
  status          String             @default("active") // active / inactive
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@map("overtime_rules")
}

// TABLE 3: Deduction Rules - Store deduction rates by position + site
model DeductionRule {
  id                    String                      @id @default(cuid())
  positionId            String                      // Position/job title
  siteId                String                      // References site ID
  name                  String                      // e.g., "Income Tax", "Health Insurance"
  type                  DeductionType               // tax, insurance, health, pension, special
  deductionType         DeductionCalculationType    // percentage or fixed_amount
  value                 Decimal                     @db.Decimal(8, 4) // % or fixed amount
  isApplicableToAll     Boolean                     @default(true) // Applies to all employees in this position/site
  riskLevel             String?                     // low, medium, high - for health/insurance variations
  effectiveDate         DateTime                    @db.Date
  endDate               DateTime?                   @db.Date
  status                String                      @default("active") // active / inactive
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([positionId, siteId, type, riskLevel])
  @@index([siteId])
  @@index([status])
  @@map("deduction_rules")
}

// TABLE 4: Payroll Periods - Define payroll periods and approval workflow
model PayrollPeriod {
  id                 String                @id @default(cuid())
  month              DateTime              @db.Date // First day of month, e.g., 2026-07-01
  startDate          DateTime              @db.Date
  endDate            DateTime              @db.Date
  status             PayrollPeriodStatus   @default(draft)
  approvedBy         String?               // FK to User (admin/HRD who approved)
  approvedAt         DateTime?
  pdfGeneratedAt     DateTime?
  notes              String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  
  // Relations
  calculations       PayrollCalculation[]  @relation("PeriodCalculations")
  overtimeHours      PayrollOvertimeHours[] @relation("PeriodOvertimeHours")
  deductionsApplied  PayrollDeductionsApplied[] @relation("PeriodDeductionsApplied")
  bonuses            PayrollBonus[]        @relation("PeriodBonuses")

  @@unique([month])
  @@index([status])
  @@map("payroll_periods")
}

// TABLE 5: Payroll Calculations - Main table storing final calculated payroll
model PayrollCalculation {
  id                  String                    @id @default(cuid())
  userId              String                    // References user ID
  payrollPeriodId     String                    // References payroll period
  payrollPeriod       PayrollPeriod             @relation("PeriodCalculations", fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  
  // Salary components
  baseSalary          Decimal                   @db.Decimal(15, 2)
  positionAllowance   Decimal                   @db.Decimal(15, 2)
  overtimeEarnings    Decimal                   @db.Decimal(15, 2) @default(0)
  bonusAmount         Decimal                   @db.Decimal(15, 2) @default(0)
  
  // Deductions
  totalDeductions     Decimal                   @db.Decimal(15, 2) @default(0)
  
  // Final amounts
  grossSalary         Decimal                   @db.Decimal(15, 2) // base + allowance + overtime + bonus
  netPay              Decimal                   @db.Decimal(15, 2) // grossSalary - totalDeductions
  
  // Status & adjustments
  status              PayrollCalculationStatus  @default(calculated)
  adjustmentAmount    Decimal?                  @db.Decimal(15, 2)
  adjustmentReason    String?
  
  // Timestamps
  calculatedAt        DateTime                  @default(now())
  approvedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([userId, payrollPeriodId])
  @@index([userId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_calculations")
}

// TABLE 6: Payroll Overtime Hours - Track overtime hours per employee per month
model PayrollOvertimeHours {
  id              String                @id @default(cuid())
  userId          String                // References user ID
  payrollPeriodId String                // References payroll period
  payrollPeriod   PayrollPeriod         @relation("PeriodOvertimeHours", fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  overtimeRuleId  String                // References overtime rule
  
  date            DateTime              @db.Date // When overtime occurred
  hours           Decimal               @db.Decimal(5, 2) // Hours worked
  hourlyRate      Decimal               @db.Decimal(12, 2) // Base hourly rate calculated from salary
  multiplier      Decimal               @db.Decimal(3, 2) // From overtime rule
  totalAmount     Decimal               @db.Decimal(15, 2) // hours × hourlyRate × multiplier
  
  description     String?               // e.g., "Backup duty on 2026-07-15"
  approvedBy      String?               // FK to User (manager approval)
  approvedAt      DateTime?
  status          OvertimeHoursStatus   @default(pending)
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([payrollPeriodId])
  @@index([overtimeRuleId])
  @@index([status])
  @@map("payroll_overtime_hours")
}

// TABLE 7: Payroll Deductions Applied - Track actual deductions per employee per month
model PayrollDeductionsApplied {
  id                String                      @id @default(cuid())
  userId            String                      // References user ID
  payrollPeriodId   String                      // References payroll period
  payrollPeriod     PayrollPeriod               @relation("PeriodDeductionsApplied", fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  deductionRuleId   String                      // References deduction rule
  
  baseSalary        Decimal                     @db.Decimal(15, 2) // Used for percentage calculations
  deductionType     String                      // Stores type for reference
  deductionName     String                      // e.g., "Income Tax"
  calculationType   DeductionCalculationType    // percentage or fixed_amount
  baseValue         Decimal                     @db.Decimal(8, 4) // % or fixed amount
  calculatedAmount  Decimal                     @db.Decimal(15, 2) // Actual deduction amount
  
  specialNotes      String?                     // e.g., "Company debt payment"
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([userId])
  @@index([payrollPeriodId])
  @@index([deductionRuleId])
  @@map("payroll_deductions_applied")
}

// TABLE 8: Payroll Bonuses - Track bonus allocations (manual only)
model PayrollBonus {
  id              String            @id @default(cuid())
  userId          String            // References user ID
  payrollPeriodId String            // References payroll period
  payrollPeriod   PayrollPeriod     @relation("PeriodBonuses", fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  
  type            BonusType         // performance, attendance, special, manual
  amount          Decimal           @db.Decimal(15, 2)
  reason          String            // Reason for bonus
  status          BonusStatus       @default(pending_approval)
  
  approvedBy      String?           // FK to User (admin/manager approval)
  approvedAt      DateTime?
  notes           String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_bonuses")
}

// Payroll model - for employee payslips and payroll records (PDF output)
model Payroll {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String   @db.VarChar(50) // e.g., 'Juli 2026'
  publishDate DateTime @default(now()) @db.Date
  pdfUrl      String?  // Supabase Storage URL for the payslip
  status      String   @default("published") @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([month])
  @@index([status])
  @@map("payrolls")
}

// Announcement model - for managing announcements and broadcasts
model Announcement {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  body              String                      @db.Text
  createdBy         String
  createdByUser     User                        @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  
  recipientType     AnnouncementRecipientType   @default(ALL_EMPLOYEES)
  recipientSiteId   String?                     // If site-specific
  recipientSite     Site?                       @relation("SiteAnnouncements", fields: [recipientSiteId], references: [id], onDelete: SetNull)
  recipientDepartment String?                   // If department-specific
  
  priority          AnnouncementPriority        @default(MEDIUM)
  attachmentUrl     String?                     // PDF or other file URL from Supabase Storage
  
  isActive          Boolean                     @default(true)
  expiresAt         DateTime?                   // Optional: auto-hide after date
  
  readStatuses      AnnouncementReadStatus[]

  @@index([createdBy])
  @@index([recipientType])
  @@index([recipientSiteId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("announcements")
}

// AnnouncementReadStatus model - tracks which users have read/dismissed announcements
model AnnouncementReadStatus {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId  String        @db.Uuid
  announcement    Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("AnnouncementReadStatus", fields: [userId], references: [id], onDelete: Cascade)
  
  readAt          DateTime?     // null = not read yet
  dismissedAt     DateTime?     // When user dismissed/archived the announcement
  createdAt       DateTime      @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
  @@index([readAt])
  @@index([dismissedAt])
  @@map("announcement_read_statuses")
}
