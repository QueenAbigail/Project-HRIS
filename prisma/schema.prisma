// This is your Prisma schema file for HRIS application,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Compatible with Supabase PostgreSQL via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums based on requirements and dummy data
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  SITE_ADMIN
  MANAGER
  STAFF
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  NOT_CHECKED_IN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  MATERNITY
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}


// Site model (from locations in constants.ts)
model Site {
  id          String                    @id @default(cuid())
  name        String
  code        String                    @unique
  totalStaff  Int? // Optional, from stats
  companyId   String?
  company     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  users       User[]
  attendances Attendance[]
  assignments EmployeeShiftAssignment[]
  patrolLocations PatrolLocation[]
  patrols     Patrol[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@map("sites")
}

// Company model (clients)
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// Shift model (from shifts in constants.ts)
model Shift {
  id                 String                    @id @default(cuid())
  name               String
  startTime          String // HH:MM
  endTime            String // HH:MM
  gracePeriodMinutes Int
  assignments        EmployeeShiftAssignment[]
  Attendance         Attendance[]
  patrols            Patrol[]

  @@map("shifts")
}

// User model (employees/admins/clients, with role, site, supervisor)
model User {
  id                    String                    @id @default(cuid())
  employeeCode          String?                   @unique
  name                  String
  email                 String                    @unique
  personalEmail         String?
  initials              String?
  department            String?
  position              String?
  role                  Role                      @default(STAFF)
  siteId                String
  site                  Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisorId          String?
  supervisor            User?                     @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees           User[]                    @relation("Supervisor")
  attendances           Attendance[]
  leaves                Leave[]                   @relation("LeaveRequester")
  leavesApproved        Leave[]                   @relation("LeaveApprover")
  assignments           EmployeeShiftAssignment[]
  patrols               Patrol[]
  deviceBindings        DeviceBinding[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  status                EmployeeStatus            @default(ACTIVE)
  joinDate              DateTime?
  phoneNumber           String?
  ktpNumber             String?                   @unique
  address               String?
  birthCity             String?
  birthDate             DateTime?
  bpjsNumber            String?
  gender                String?
  religion              String?
  maritalStatus         String?
  employmentStatus      String?
  bloodType             String?
  npwpNumber            String?
  ktaNumber             String?
  certifications        String[]
  ktaExpiry             DateTime?
  allowMobileAttendance Boolean                   @default(false)
  allowWebAppAccess     Boolean                   @default(false)

  @@index([siteId])
  @@index([supervisorId])
  @@index([email])
  @@map("users")
}


// Junction for Employee Shift Assignment (schedules with workingDays array)
model EmployeeShiftAssignment {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       Shift  @relation(fields: [shiftId], references: [id])
  siteId      String
  site        Site   @relation(fields: [siteId], references: [id])
  workingDays Json // [0,1,2,3,4,5,6] as array of ints (Sun=0)

  @@unique([userId, shiftId, siteId])
  @@map("employee_shift_assignments")
}

// Attendance model (extended with GPS/selfie)
model Attendance {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime // Full datetime for date only in queries
  locationId     String
  location       Site             @relation(fields: [locationId], references: [id])
  shiftId        String?
  shift          Shift?           @relation(fields: [shiftId], references: [id])
  scheduledStart String? // HH:MM
  scheduledEnd   String? // HH:MM
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         AttendanceStatus @default(NOT_CHECKED_IN)
  lateMinutes    Int              @default(0)
  gpsLat         Float?
  gpsLng         Float?
  selfieCheckIn  String? // URL
  selfieCheckOut String? // URL
  notes          String?

  @@unique([userId, date])
  @@index([userId])
  @@index([locationId])
  @@index([date])
  @@map("attendances")
}

// Leave model (requests with approval)
model Leave {
  id          String      @id @default(cuid())
  requesterId String
  requester   User        @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approverId  String?
  approver    User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  status      LeaveStatus @default(PENDING)
  notes       String?

  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@map("leaves")
}

// Global system settings for branding
model SystemSettings {
  id             String  @id @default(cuid())
  logoUrl        String?
  appName        String  @default("SecureGuard")
  appDescription String  @default("HR Administration")

  @@map("system_settings")
}

model MasterData {
  id        String   @id @default(cuid())
  category  String   
  value     String   
  isActive  Boolean  @default(true) 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@map("master_data")
}

// Patrol Location model (specific locations at a site for patrol check-ins)
model PatrolLocation {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String   // Name of patrol location (e.g., "Gate A", "Building 1 Entrance")
  barcode   String   @unique // Barcode for scanning
  latitude  Float    // GPS coordinates for validation
  longitude Float
  isActive  Boolean  @default(true)
  patrols   Patrol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("patrol_locations")
}

// Patrol model (patrol check-ins by user at specific times)
model Patrol {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  patrolLocationId  String
  patrolLocation    PatrolLocation      @relation(fields: [patrolLocationId], references: [id], onDelete: Cascade)
  shiftId           String?
  shift             Shift?              @relation(fields: [shiftId], references: [id])
  date              DateTime            // Date of patrol
  status            PatrolStatus        @default(NOT_STARTED)
  checkInTime       DateTime?           // Actual check-in time
  gpsLat            Float?              // Actual GPS latitude for validation
  gpsLng            Float?              // Actual GPS longitude
  gpsAccuracy       Float?              // GPS accuracy in meters
  barcodeScanned    Boolean             @default(false)
  gpsValidated      Boolean             @default(false)
  description       String?             // Description of patrol findings
  evidence          PatrolEvidence[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([userId, patrolLocationId, date])
  @@index([userId])
  @@index([siteId])
  @@index([patrolLocationId])
  @@index([date])
  @@map("patrols")
}

// Patrol Evidence model (photos/documents from patrol)
model PatrolEvidence {
  id       String   @id @default(cuid())
  patrolId String
  patrol   Patrol   @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  imageUrl String   // URL to uploaded image
  caption  String? // Description of what the photo shows
  createdAt DateTime @default(now())

  @@index([patrolId])
  @@map("patrol_evidence")
}

// Device Binding model - restricts accounts to single device/app login
model DeviceBinding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String   @unique // Unique device identifier from mobile app
  deviceName    String   // e.g., "Samsung Galaxy S23 (Android)", "iPhone 14 Pro (iOS)"
  deviceType    String   // "mobile" or "app"
  appVersion    String?  // App version when bound
  bindDate      DateTime @default(now())
  lastUsed      DateTime @updatedAt
  isActive      Boolean  @default(true)

  @@unique([userId, deviceType]) // One mobile device + one app per user
  @@index([userId])
  @@index([deviceId])
  @@map("device_bindings")
}
